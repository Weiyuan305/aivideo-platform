# Copy to apps/web/.env.local. All secrets stay on the server.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
# Default browser mode retains IndexedDB. Set server to enable PostgreSQL tasks/resources.
WORKSPACE_BACKEND=browser
# Explicit loopback-only single-owner mode when auth is not configured. Disable for public use.
LOCAL_WORKSPACE_ENABLED=false
# Absolute persistent private directory shared by Web and worker. S3 takes priority if S3_BUCKET is set.
PRIVATE_STORAGE_ROOT=
# Image/video: Nano Banana 2/Pro, Seedance 2.0, MiniMax Hailuo 2.3, FLUX.2, Kling O3.
# These entries currently share fal as the reserved API route, not direct vendor APIs.
# Agnes Flash: key enables only the implemented image/video models in server mode.
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
FAL_KEY=
REPLICATE_API_TOKEN=
REPLICATE_INDEXTTS_VERSION=
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Other model adapters remain disabled even when their keys are populated.

# Independent lightweight operations process; shared by Web and ops, outside private files.
OPS_STATE_ROOT=
BACKUP_ROOT=
# PostgreSQL client binary directory, or leave blank if pg_dump/pg_restore are in PATH.
PG_BIN_DIR=
OPS_CHECK_INTERVAL_SECONDS=30
BACKUP_INTERVAL_HOURS=24
BACKUP_MAX_AGE_HOURS=26
# Optional: leave blank for local alerts only. No external delivery by default.
OPS_WEBHOOK_URL=
OPS_WEBHOOK_TOKEN=
# Restore ONLY into a new aivideo_restore_* database and empty storage.
RESTORE_DATABASE_URL=
RESTORE_STORAGE_ROOT=
RESTORE_S3_BUCKET=
RESTORE_S3_ENDPOINT=
RESTORE_S3_REGION=auto
RESTORE_S3_ACCESS_KEY_ID=
RESTORE_S3_SECRET_ACCESS_KEY=

# Local waveform/caption preview and CPU movie export; no model credentials.
# Web and worker need FFmpeg with libx264/AAC/overlay/concat/amix/xfade/acrossfade.
# Optional absolute paths when binaries are not on Web/worker PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# Use the same Pango font description and font file for Web and worker.
# Linux: install fonts-noto-cjk; macOS uses the system Chinese fallback.
RENDER_FONT=sans 32
RENDER_FONT_FILE=
